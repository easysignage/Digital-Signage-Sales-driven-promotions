# API key from the CMS: Settings → API Keys (Premium / Enterprise plans).
# Needs media, playlists and displays permissions.
EASYSIGNAGE_API_KEY=ds_api_...
# White-label accounts only: your own API host.
# EASYSIGNAGE_BASE_URL=

# Media carrying this tag is turned on above the threshold and off below it.
PROMO_TAG=promo
# Screens carrying this tag are published after every change.
SCREEN_TAG=automation
THRESHOLD=100
PORT=3000
